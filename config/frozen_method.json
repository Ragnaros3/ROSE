    "neighbor_pool": 45,
    "similarity_floor": 0.01
  },
  "package_version": "1.1.0",
  "protocol": {
    "cluster_counts": {
      "bdgp": 5,
      "fashion": 10,
      "handwritten": 10,
      "hdigit": 10,
      "mnist_usps": 10
    },
    "datasets": [
      "bdgp",
      "fashion",
      "handwritten",
      "hdigit",
      "mnist_usps"
    ],
    "entry_missing_ratio": "eta / number_of_views",
