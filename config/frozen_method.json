    "dropout": 0.1,
    "epochs": 120,
    "evaluation_interval": 5,
    "latent_width": 32,
    "learning_rate": 0.001,
    "loss_weights": {
      "cross_view": 0.05,
      "reconstruction": 0.1,
      "spectral": 1.0
    },
    "optimizer": "AdamW",
